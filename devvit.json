{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modscope",
  "permissions": {
    "reddit": true,
    "redis": true,
    "realtime": true,
    "http": {
      "enable": false,
      "domains": ["raw.githubusercontent.com"]
    }
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "dashboard-inline.html"
      },
      "expanded": {
        "entry": "dashboard-expanded.html",
        "height": "tall"
      },
      "metric": {
        "entry": "metric-widget.html",
        "height": "short"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "media": {
    "dir": "assets/"
  },
  "marketingAssets": {
    "icon": "assets/icon.png"
  },
  "menu": {
    "items": [
      {
        "label": "Open ModScope Dashboard",
        "description": "View subreddit analytics and insights",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/open-dashboard"
      },
      {
        "label": "Reset Launcher Post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/clear-cache"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onAppUpgrade": "/internal/triggers/on-app-upgrade",
    "onPostDelete": "/internal/triggers/on-post-delete",
    "onCommentDelete": "/internal/triggers/on-comment-delete",
    "onPostUpdate": "/internal/triggers/on-post-update"
  },
  "scheduler": {
    "tasks": {
      "snapshot-worker": {
        "endpoint": "/internal/triggers/tasks/snapshot-worker"
      },
      "delete-snapshot": {
        "endpoint": "/internal/triggers/tasks/delete-snapshot"
      },
      "report-worker": {
        "endpoint": "/internal/triggers/tasks/report-worker"
      },
      "metric-worker": {
        "endpoint": "/internal/triggers/tasks/metric-worker"
      },
      "metric-snapshot-cleanup": {
        "endpoint": "/internal/triggers/tasks/metric-snapshot-cleanup",
        "cron": "30 8 * * *"
      },
      "purge-expired-deletions": {
        "endpoint": "/internal/triggers/tasks/purge-expired-deletions",
        "cron": "0 10 * * *"
      },
      "sidebar-live-refresh": {
        "endpoint": "/internal/triggers/tasks/sidebar-live-refresh"
      },
      "check-for-updates": {
        "endpoint": "/internal/triggers/tasks/check-for-updates",
        "cron": "0 15 * * 1"
      },
      "apply-pending-schema-patches": {
        "endpoint": "/internal/triggers/tasks/apply-pending-schema-patches"
      },
      "identity-reverify-cron": {
        "endpoint": "/internal/triggers/tasks/identity-reverify-cron",
        "cron": "0 9 * * 0"
      },
      "identity-reverify-worker": {
        "endpoint": "/internal/triggers/tasks/identity-reverify-worker"
      }
    }
  },
  "dev": {
    "subreddit": "modscope_dev"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  }
}
